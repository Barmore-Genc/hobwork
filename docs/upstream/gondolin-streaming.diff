+  const head = raw.slice(0, headerEnd).toLowerCase();
+  const body = raw.slice(headerEnd + 4);
+  return {
+    head,
+    body: /\r\ntransfer-encoding: chunked(\r\n|$)/.test(head)
+      ? decodeChunked(body)
+      : body,
+  };
+}
