+test("ChunkedBodyDecoder decodes input split at every byte", () => {
+  const framed =
+    "5;ext=1\r\nhello\r\n1\r\n \r\n5\r\nworld\r\n0\r\nx-trailer: 1\r\n\r\nNEXT";
+  const decoder = new qemuHttp.ChunkedBodyDecoder();
+  const body: Buffer[] = [];
+  let extra = Buffer.alloc(0);
+  for (let i = 0; i < framed.length; i += 1) {
+    const result = decoder.push(Buffer.from(framed[i]!, "latin1"));
+    body.push(...result.body);
+    extra = Buffer.concat([extra, result.extra]);
+  }
+  assert.equal(decoder.done, true);
+  assert.equal(Buffer.concat(body).toString(), "hello world");
+  assert.equal(extra.toString(), "NEXT");
+});
