+function decodeChunked(raw: string): string {
+  let out = "";
+  let offset = 0;
+  while (true) {
+    const lineEnd = raw.indexOf("\r\n", offset);
+    assert.notEqual(lineEnd, -1, "incomplete chunked body");
+    const size = parseInt(raw.slice(offset, lineEnd), 16);
+    if (size === 0) return out;
+    out += raw.slice(lineEnd + 2, lineEnd + 2 + size);
+    offset = lineEnd + 2 + size + 2;
+  }
+}
