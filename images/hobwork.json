{
  "imageName": "hobwork",
  "arch": "aarch64",
  "distro": "alpine",
  "env": {
    "PATH": "/opt/hobwork/platform/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "npm_config_update_notifier": "false"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "bash",
      "ca-certificates",
      "curl",
      "e2fsprogs",
      "e2fsprogs-extra",
      "git",
      "nodejs",
      "npm",
      "tzdata"
    ],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "postBuild": {
    "copy": [
      {
        "src": "./build/icu-data",
        "dest": "/usr/share/icu"
      },
      {
        "src": "./build/fonts/InterVariable.ttf",
        "dest": "/opt/hobwork/fonts/InterVariable.ttf"
      },
      {
        "src": "./fonts/fonts.conf",
        "dest": "/opt/hobwork/fonts/fonts.conf"
      },
      {
        "src": "./platform/package.json",
        "dest": "/opt/hobwork/platform/package.json"
      },
      {
        "src": "./platform/pnpm-lock.yaml",
        "dest": "/opt/hobwork/platform/pnpm-lock.yaml"
      },
      {
        "src": "../packages/sdk/package.json",
        "dest": "/opt/hobwork/sdk/package.json"
      },
      {
        "src": "../packages/sdk/hobwork.schema.json",
        "dest": "/opt/hobwork/sdk/hobwork.schema.json"
      },
      {
        "src": "../packages/sdk/src",
        "dest": "/opt/hobwork/sdk/src"
      },
      {
        "src": "../packages/theme/package.json",
        "dest": "/opt/hobwork/theme/package.json"
      },
      {
        "src": "../packages/theme/tailwind.css",
        "dest": "/opt/hobwork/theme/tailwind.css"
      },
      {
        "src": "../packages/theme/theme.css",
        "dest": "/opt/hobwork/theme/theme.css"
      }
    ],
    "commands": [
      "npm install --global pnpm@12.5.1",
      "cd /opt/hobwork/platform && pnpm install --frozen-lockfile --store-dir /opt/hobwork/pnpm-store",
      "mkdir -p /opt/hobwork/platform/node_modules/@hobwork && mv /opt/hobwork/sdk /opt/hobwork/platform/node_modules/@hobwork/sdk && mv /opt/hobwork/theme /opt/hobwork/platform/node_modules/@hobwork/theme",
      "rm -rf /opt/hobwork/pnpm-store /root/.npm /root/.cache /root/.local /tmp/*",
      "ln -s /opt/hobwork/platform/node_modules /node_modules",
      "mkdir -p /workspace"
    ]
  }
}
