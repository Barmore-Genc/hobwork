{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hobwork.dev/schemas/hobwork.json",
  "title": "hobwork.json",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "handlerPath": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
  },
  "properties": {
    "crons": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schedule", "handler"],
        "properties": {
          "schedule": { "type": "string", "pattern": "^\\S+( \\S+){4}$" },
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "webhooks": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handler"],
        "properties": {
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": { "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handler"],
        "properties": {
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "triggers": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handler"],
        "oneOf": [{ "required": ["homeassistant"] }, { "required": ["device"] }],
        "properties": {
          "homeassistant": { "type": "object" },
          "device": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "event"],
            "properties": {
              "capability": { "enum": ["notifications"] },
              "event": { "enum": ["action"] }
            }
          },
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "egress": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "idleTimeout": { "type": "string", "pattern": "^\\d+(ms|s|m|h|d)$" },
    "icon": {
      "description": "The project's icon, shown as its app's favicon and home screen icon and in project lists: one emoji (\"🧵\") or the path of an SVG, PNG, JPEG or WebP image in the repo (\"ui/icon.svg\"). Hobwork renders it to every size it needs. Without it, the icon is the project's first letter.",
      "type": "string",
      "anyOf": [
        { "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[^\\\\]+\\.(svg|png|jpe?g|webp)$" },
        { "pattern": "^[^./\\\\\\s]{1,16}$" }
      ]
    }
  }
}
