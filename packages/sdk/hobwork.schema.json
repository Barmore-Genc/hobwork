{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hobwork.dev/schemas/hobwork.json",
  "title": "hobwork.json",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "handlerPath": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "cspHost": { "type": "string", "pattern": "^(https?|wss?)://(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:\\d{1,5})?(/[^\\s;,'\"\\\\]*)?$" },
    "cspSources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/cspHost" } },
    "cspSourcesWithSchemes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "anyOf": [{ "$ref": "#/definitions/cspHost" }, { "enum": ["data:", "blob:"] }] }
    }
  },
  "properties": {
    "crons": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schedule", "handler"],
        "properties": {
          "schedule": { "type": "string", "pattern": "^\\S+( \\S+){4}$" },
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "webhooks": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handler"],
        "properties": {
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": { "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handler"],
        "properties": {
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "triggers": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handler"],
        "oneOf": [{ "required": ["homeassistant"] }, { "required": ["device"] }],
        "properties": {
          "homeassistant": { "type": "object" },
          "device": {
            "description": "Runs the handler on a device event: notifications/action (an action tapped on a notification this hob sent), focus/changed (a Focus mode with a Hobwork Focus filter turned on or off), nfc/scanned (a tag this hob wrote was scanned, or with url any scanned URL starting with it), health/samples (new Health samples). ctx.payload is the matching DeviceEvent from @hobwork/sdk.",
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "event"],
            "properties": {
              "capability": { "enum": ["notifications", "focus", "nfc", "health"] },
              "event": { "enum": ["action", "changed", "scanned", "samples"] },
              "device": {
                "description": "Only events from the device with this name, as ctx.device() takes it.",
                "$ref": "#/definitions/name"
              },
              "url": {
                "description": "nfc/scanned only: runs the handler for scanned URLs that start with this, such as \"https://example.com/spools/\", from tags Hobwork did not write too. Tags reach Hobwork through the app's Scan Tag button or the \"Send Tag to Hobwork\" Shortcuts action. Without it, only tags this hob wrote.",
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "allOf": [
              { "if": { "required": ["url"] }, "then": { "properties": { "capability": { "const": "nfc" } } } },
              { "if": { "properties": { "capability": { "const": "notifications" } } }, "then": { "properties": { "event": { "const": "action" } } } },
              { "if": { "properties": { "capability": { "const": "focus" } } }, "then": { "properties": { "event": { "const": "changed" } } } },
              { "if": { "properties": { "capability": { "const": "nfc" } } }, "then": { "properties": { "event": { "const": "scanned" } } } },
              { "if": { "properties": { "capability": { "const": "health" } } }, "then": { "properties": { "event": { "const": "samples" } } } }
            ]
          },
          "handler": { "$ref": "#/definitions/handlerPath" }
        }
      }
    },
    "egress": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "csp": {
      "description": "Extra sources for the Content-Security-Policy of the hob's app. By default the app runs only scripts from its own origin (no inline scripts) and loads styles, images, fonts and connections from its own origin (also inline styles, and data: and blob: images, data: fonts). Each directive lists what to allow in addition: http(s):// or ws(s):// origins (\"https://cdn.example.com\", \"https://*.example.com\", \"wss://live.example.com\"), data: or blob: where the directive takes them, and in script-src the keywords \"'unsafe-inline'\", \"'unsafe-eval'\" and \"'wasm-unsafe-eval'\", which remove the protection against injected scripts. frame-ancestors cannot be changed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script-src": {
          "type": "array",
          "uniqueItems": true,
          "items": { "anyOf": [{ "$ref": "#/definitions/cspHost" }, { "enum": ["'unsafe-inline'", "'unsafe-eval'", "'wasm-unsafe-eval'"] }] }
        },
        "style-src": { "$ref": "#/definitions/cspSourcesWithSchemes" },
        "img-src": { "$ref": "#/definitions/cspSourcesWithSchemes" },
        "font-src": { "$ref": "#/definitions/cspSourcesWithSchemes" },
        "connect-src": { "$ref": "#/definitions/cspSourcesWithSchemes" },
        "media-src": { "$ref": "#/definitions/cspSourcesWithSchemes" },
        "frame-src": { "$ref": "#/definitions/cspSources" },
        "worker-src": { "$ref": "#/definitions/cspSources" },
        "manifest-src": { "$ref": "#/definitions/cspSources" },
        "form-action": { "$ref": "#/definitions/cspSources" }
      }
    },
    "idleTimeout": { "type": "string", "pattern": "^\\d+(ms|s|m|h|d)$" },
    "icon": {
      "description": "The hob's icon, shown as its app's favicon and home screen icon and in hob lists: one emoji (\"🧵\") or the path of an SVG, PNG, JPEG or WebP image in the repo (\"ui/icon.svg\"). Hobwork renders it to every size it needs. Without it, the icon is the hob's first letter.",
      "type": "string",
      "anyOf": [
        { "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[^\\\\]+\\.(svg|png|jpe?g|webp)$" },
        { "pattern": "^[^./\\\\\\s]{1,16}$" }
      ]
    }
  }
}
