{
  "name": "@earendil-works/gondolin",
  "version": "0.12.0",
  "description": "Alpine Linux sandbox for running untrusted code with controlled filesystem and network access",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "gondolin": "./dist/bin/gondolin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "sandbox",
    "vm",
    "qemu",
    "alpine",
    "linux",
    "isolation",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/earendil-works/gondolin.git",
    "directory": "host"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "cbor2": "^2.3.0",
    "node-forge": "^1.3.3",
    "ssh2": "^1.17.0",
    "undici": "^6.21.0"
  },
  "optionalDependencies": {
    "@earendil-works/gondolin-krun-runner-darwin-arm64": "0.12.0",
    "@earendil-works/gondolin-krun-runner-linux-x64": "0.12.0"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "private": true
}
